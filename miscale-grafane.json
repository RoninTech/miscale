{
  "__inputs": [
    {
      "name": "DS_INFLUXDB",
      "label": "InfluxDB",
      "description": "Point this at your miscale InfluxDB 1.8 datasource (InfluxQL query language)",
      "type": "datasource",
      "pluginId": "influxdb",
      "pluginName": "InfluxDB"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.0.0" },
    { "type": "datasource", "id": "influxdb", "name": "InfluxDB", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Weight (kg)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": "${DS_INFLUXDB}",
      "fieldConfig": { "defaults": { "unit": "kg" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": "${DS_INFLUXDB}",
          "query": "SELECT mean(\"weight_kg\") FROM \"weight\" WHERE (\"user\" =~ /^$user$/) AND $timeFilter GROUP BY time($__interval), \"user\" fill(previous)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "$tag_user"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "BMI",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": "${DS_INFLUXDB}",
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": "${DS_INFLUXDB}",
          "query": "SELECT mean(\"bmi\") FROM \"weight\" WHERE (\"user\" =~ /^$user$/) AND $timeFilter GROUP BY time($__interval), \"user\" fill(previous)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "$tag_user"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Body Fat % (estimate, not impedance-based)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": "${DS_INFLUXDB}",
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": "${DS_INFLUXDB}",
          "query": "SELECT mean(\"fat_percent_est\") FROM \"weight\" WHERE (\"user\" =~ /^$user$/) AND $timeFilter GROUP BY time($__interval), \"user\" fill(previous)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "$tag_user"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Body Water % (estimate, not impedance-based)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": "${DS_INFLUXDB}",
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": "${DS_INFLUXDB}",
          "query": "SELECT mean(\"water_percent_est\") FROM \"weight\" WHERE (\"user\" =~ /^$user$/) AND $timeFilter GROUP BY time($__interval), \"user\" fill(previous)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "$tag_user"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Lean Mass, kg (estimate, not impedance-based)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": "${DS_INFLUXDB}",
      "fieldConfig": { "defaults": { "unit": "kg" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": "${DS_INFLUXDB}",
          "query": "SELECT mean(\"lean_mass_kg_est\") FROM \"weight\" WHERE (\"user\" =~ /^$user$/) AND $timeFilter GROUP BY time($__interval), \"user\" fill(previous)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "$tag_user"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Latest Weight",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": "${DS_INFLUXDB}",
      "fieldConfig": { "defaults": { "unit": "kg" }, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "datasource": "${DS_INFLUXDB}",
          "query": "SELECT last(\"weight_kg\") FROM \"weight\" WHERE (\"user\" =~ /^$user$/) AND \"user\" != 'unassigned' GROUP BY \"user\"",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "$tag_user"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Classifier Confidence",
      "description": "System health check, not a body metric — a downward trend over time could mean the two users' weight/impedance profiles are converging and confidence_gap_threshold may need retuning.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": "${DS_INFLUXDB}",
      "fieldConfig": { "defaults": { "min": 0, "max": 1 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": "${DS_INFLUXDB}",
          "query": "SELECT mean(\"confidence\") FROM \"weight\" WHERE (\"user\" =~ /^$user$/) AND $timeFilter GROUP BY time($__interval), \"user\" fill(previous)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "$tag_user"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Weigh-in Frequency (per day)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": "${DS_INFLUXDB}",
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": "${DS_INFLUXDB}",
          "query": "SELECT count(\"weight_kg\") FROM \"weight\" WHERE (\"user\" =~ /^$user$/) AND \"user\" != 'unassigned' AND $timeFilter GROUP BY time(1d), \"user\" fill(0)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "$tag_user"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 60 } },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Recent Ambiguous Readings",
      "description": "Readings not auto-assigned to either user \u2014 review and consider adjusting confidence_gap_threshold if this list grows quickly.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 },
      "datasource": "${DS_INFLUXDB}",
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {},
      "targets": [
        {
          "datasource": "${DS_INFLUXDB}",
          "query": "SELECT \"weight_kg\", \"impedance_ohm\", \"dist_user1\", \"dist_user2\", \"confidence\" FROM \"weight\" WHERE \"user\" = 'unassigned' AND $timeFilter ORDER BY time DESC LIMIT 50",
          "rawQuery": true,
          "resultFormat": "table"
        }
      ]
    }
  ],
  "refresh": "5m",
  "schemaVersion": 39,
  "tags": ["miscale", "influxdb"],
  "templating": {
    "list": [
      {
        "name": "user",
        "type": "query",
        "datasource": "${DS_INFLUXDB}",
        "query": "SHOW TAG VALUES FROM \"weight\" WITH KEY = \"user\"",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" },
        "sort": 1
      }
    ]
  },
  "time": { "from": "now-90d", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Mi Scale \u2014 Weight Tracking",
  "uid": "miscale-weight-tracking",
  "version": 1,
  "weekStart": ""
}
