# Mi Scale BLE Monitor — Configuration (sanitized example)
# Copy this file to miscale.toml and fill in your values.
# Keep miscale.toml out of version control — it contains sensitive personal data.

[scan]
# MAC address of the scale
scale_mac = "XX:XX:XX:XX:XX:XX"

# Bluetooth adapter to use
hci_device = "hci0"

# Scan interval in seconds (seconds between scan cycles)
scan_interval = 5

# Seconds between readings to consider a new measurement session
session_gap_seconds = 5

[logging]
# Log file path (set to "" to disable file logging)
log_file = "~/.local/share/miscale/miscale.log"

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
log_level = "INFO"

[user_info]

[user_info.person1]
name = "Person1"
start_weight = 70.0
# start_impedance = 500.0   # optional; falls back to detection.default_start_impedance
height = 170
age = 40
gender = "male"

[user_info.person2]
name = "Person2"
start_weight = 70.0
# start_impedance = 500.0   # optional; falls back to detection.default_start_impedance
height = 165
age = 40
gender = "female"

[detection]
# All of these are optional — sane defaults are used if omitted.

# Where per-user Kalman filter state (weight/impedance estimate + last-seen
# time) is persisted between runs, so the app doesn't re-bootstrap from
# start_weight every restart. Only used on a genuine first run per user.
state_file = "~/.cache/miscale/user_state.json"

# Starting impedance guess for a user with no start_impedance set above.
# Gets overwritten quickly once real readings come in.
default_start_impedance = 500.0

# How much each user's true weight/impedance is allowed to drift between
# readings (higher = filter adapts faster to real change, but is less
# resistant to noise).
process_var_weight = 0.02
process_var_impedance = 4.0

# Expected noise in a single scale reading.
meas_var_weight = 0.09
meas_var_impedance = 25.0

# Minimum separation (in normalized distance units) between the best and
# second-best candidate user required to auto-assign a reading. Below this,
# the reading is logged as ambiguous instead of guessed.
confidence_gap_threshold = 1.0

# Maximum plausible day-over-day weight change (kg) for one user; readings
# implying a bigger jump are penalized when scored against that user.
max_plausible_delta_kg_per_day = 2.0

[influxdb]
# InfluxDB 1.x settings
host = "localhost"
port = 8086
database = "miscale"
retention_policy = "autogen"
# Turns on the influxdb handling otherwise only logging occurs.
enabled = true

# If InfluxDB isn't reachable yet at startup (e.g. its Docker container is
# still initializing when this service starts), retry this many times,
# waiting startup_retry_delay_seconds between attempts, before giving up
# for the rest of this run's initial connection. Default: 6 retries x 5s
# = up to ~30s of waiting, without blocking indefinitely if InfluxDB is
# genuinely down or misconfigured.
startup_retries = 6
startup_retry_delay_seconds = 5
 
# After giving up on startup, keep retrying in the background at this
# interval — self-heals if InfluxDB comes up later or bounces mid-run,
# without needing to restart this script.
reconnect_interval_seconds = 60

[ntfy]
# Ambiguous-reading confirmation via a self-hosted ntfy server on your LAN.
# When enabled, an ambiguous reading is held (not written to InfluxDB) and
# a notification is sent with one tap button per user plus "Neither" —
# tapping resolves it immediately. Unanswered readings are written as
# "unassigned" after pending_timeout_hours, same as when this is disabled.
enabled = false
 
# Port your self-hosted ntfy server is exposed on. base_url is normally
# auto-detected at startup (this machine's LAN IP + this port) — this is
# the one piece auto-detection can't guess for you.
port = 8080
 
# Uncomment and set explicitly only if auto-detection picks the wrong
# address (e.g. machine has multiple network interfaces, an active
# VPN, or Docker networking that confuses the auto-detected route). Must
# be reachable from your phone, not just from this machine — "localhost"
# will NOT work here, since it's baked into the notification's tap-action
# URLs, which your phone executes, not this script.
# base_url = "http://192.168.1.50:8080"

# Two distinct topics: your phone subscribes to `topic` to receive the
# notification; `reply_topic` is where tapping a button POSTs the answer,
# and what this script long-polls to hear about it. Pick anything —
# since this is LAN-only and self-hosted, no need for a random/secret name.
topic = "miscale-ambiguous"
reply_topic = "miscale-ambiguous-reply"
 
# How long to wait for a reply before giving up and writing the reading
# as "unassigned".
pending_timeout_hours = 24
 
# Where ambiguous readings awaiting a reply are persisted between restarts.
pending_file = "~/.cache/miscale/pending_confirmations.json"

# Optionally also push every successfully-attributed reading (auto or
# manually confirmed) to its own per-user topic — e.g. "paul" gets
# notified on "miscale_paul_weight_reading" only, never sees Helen's.
# {user} is replaced with the config key (paul/helen).
send_weight_readings = false
weight_reading_topic_template = "miscale_{user}_weight_reading"
